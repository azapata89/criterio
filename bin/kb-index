#!/usr/bin/env python3
"""Regenera el listado automático de docs/knowledge/INDEX.md.

Uso: kb-index [--init] [--root RUTA]
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
import kb  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[1])
    parser.add_argument("--init", action="store_true", help="crea la estructura si no existe")
    parser.add_argument("--root", help="raíz del proyecto (por defecto: CLAUDE_PROJECT_DIR o git)")
    args = parser.parse_args()

    root = kb.project_root(args.root)
    base = root / kb.KB_DIR
    if args.init:
        kb.init_kb(root)
    elif not base.is_dir():
        print(f"No existe {base}. Usa --init para crearla.", file=sys.stderr)
        return 1
    listed, dropped = kb.build_index(base)
    msg = f"INDEX actualizado: {listed} entradas"
    if dropped:
        msg += f" ({dropped} omitidas por el límite de {kb.MAX_INDEX_LINES} líneas)"
    print(msg)
    return 0


if __name__ == "__main__":
    sys.exit(main())
